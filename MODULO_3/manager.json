    {
      "parameters": {
        "jsCode": "// Obtener el resultado devuelto por el Worker o el paso anterior\nconst item = $json;\n\n// Obtener datos contextuales del Router inicial\nconst routerData = $('Code in JavaScript').first()?.json ?? {};\nconst originalInput = routerData.original_input ?? $('Edit Fields').first()?.json.original_input ?? 'Sin dato';\n\n// Fecha formateada en zona horaria local\nconst now = new Date();\nconst timestamp = now.toLocaleString('es-AR', { \n  timeZone: 'America/Argentina/Buenos_Aires',\n  hour12: false \n});\n\nreturn [{\n  json: {\n    timestamp: timestamp,\n    original_input: originalInput,\n    intent: routerData.intent ?? item.worker ?? 'UNKNOWN',\n    confidence: routerData.confidence ?? null,\n    risk: routerData.risk ?? 'LOW',\n    worker: item.worker ?? 'DESCONOCIDO',\n    status: item.status ?? 'success',\n    respuesta: item.respuesta ?? (typeof item === 'string' ? item : JSON.stringify(item)),\n    requires_human: Boolean(item.requires_human),\n    human_decision: item.human_decision ?? (item.requires_human ? 'PENDIENTE' : 'N/A')\n  }\n}];"
      },
